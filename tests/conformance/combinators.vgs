// Conformance vectors for combinators (generated by tools/gen_conformance.py)
// run: @map_arr file:vectors/combinators_map_arr.json
// run: @map_tensor file:vectors/combinators_map_tensor.json
// run: @fold_arr file:vectors/combinators_fold_arr.json
// run: @gen_arr file:vectors/combinators_gen_arr.json
// run: @gen_slice file:vectors/combinators_gen_slice.json
// run: @guard_demo file:vectors/combinators_guard_demo.json
// run: @guard_branch_demo file:vectors/combinators_guard_branch_demo.json
// run: @call_demo file:vectors/combinators_call_demo.json
module conf_combinators;

NODE @add_k {
  SIGNATURE: (x: i32, k: i32) -> (i32);
  EFFECTS: [];
  CONTRACT { PRE: x >= -1000; }
  BODY {
    %0 = ADD.checked(x, k);
    RETURN(%0);
  }
}

NODE @map_arr {
  SIGNATURE: (xs: Array<i32, 3>, k: i32) -> (Array<i32, 3>);
  EFFECTS: [];
  CONTRACT {}
  BODY {
    %0 = SIMD_MAP(@add_k, xs, k);
    RETURN(%0);
  }
}

NODE @map_tensor {
  SIGNATURE: (t: Tensor<i32, [2, 2]>, k: i32) -> (Tensor<i32, [2, 2]>);
  EFFECTS: [];
  CONTRACT {}
  BODY {
    %0 = SIMD_MAP(@add_k, t, k);
    RETURN(%0);
  }
}

NODE @fold_step {
  SIGNATURE: (acc: i32, elem: i32, mult: i32) -> (i32);
  EFFECTS: [];
  CONTRACT { PRE: elem >= 0; }
  BODY {
    // Non-commutative step: acc * mult - elem to verify strict left-to-right element order.
    %0 = MUL.checked(acc, mult);
    %1 = SUB.checked(%0, elem);
    RETURN(%1);
  }
}

NODE @fold_arr {
  SIGNATURE: (xs: Slice<i32>, mult: i32, init: i32) -> (i32);
  EFFECTS: [];
  CONTRACT {
    INVARIANT @inv(k, acc): k >= 0;
  }
  BODY {
    %0 = FOLD_BOUNDED(@fold_step, xs, mult, init=init, invariant=@inv);
    RETURN(%0);
  }
}

NODE @gen_kernel {
  SIGNATURE: (idx: u64, scale: u64) -> (u64);
  EFFECTS: [];
  CONTRACT { PRE: scale <= 1000; }
  BODY {
    %0 = MUL.checked(idx, scale);
    RETURN(%0);
  }
}

NODE @gen_arr {
  SIGNATURE: (scale: u64) -> (Array<u64, 4>);
  EFFECTS: [];
  CONTRACT {}
  BODY {
    %0 = GENERATE(@gen_kernel, 4:u64, scale);
    RETURN(%0);
  }
}

NODE @gen_slice {
  SIGNATURE: (n: u64, scale: u64) -> (Slice<u64>);
  EFFECTS: [ARENA];
  CONTRACT {}
  BODY {
    %0 = GENERATE(@gen_kernel, n, scale);
    RETURN(%0);
  }
}

NODE @safe_div {
  SIGNATURE: (a: i32, b: i32) -> (i32, i32);
  EFFECTS: [];
  CONTRACT { PRE: b != 0; }
  BODY {
    %0 = DIV.checked(a, b);
    %1 = MOD.checked(a, b);
    RETURN(%0, %1);
  }
}

NODE @zero_pair {
  SIGNATURE: (a: i32, b: i32) -> (i32, i32);
  EFFECTS: [];
  CONTRACT {}
  BODY {
    RETURN(0:i32, a);
  }
}

NODE @guard_demo {
  SIGNATURE: (a: i32, b: i32) -> (i32, i32);
  EFFECTS: [];
  CONTRACT {}
  BODY {
    %0 = NE(b, 0:i32);
    %1, %2 = ASSERT_GUARD(%0, @safe_div, a, b, else=@zero_pair);
    RETURN(%1, %2);
  }
}

NODE @guard_branch_demo {
  SIGNATURE: (a: i32, b: i32) -> (i32, i32);
  EFFECTS: [];
  CONTRACT {}
  BODY {
    %0 = NE(b, 0:i32);
    %1, %2 = ASSERT_GUARD.branch(%0, @safe_div, a, b, else=@zero_pair);
    RETURN(%1, %2);
  }
}

NODE @call_demo {
  SIGNATURE: (a: i32, b: i32) -> (i32, i32);
  EFFECTS: [];
  CONTRACT {}
  BODY {
    %0, %1 = CALL_HASH(@safe_div, a, b);
    RETURN(%0, %1);
  }
}
