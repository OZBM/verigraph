module mesh_arena_effects;

NODE @zero_u32 {
  SIGNATURE: (idx: u64) -> (u32);
  EFFECTS: [];
  CONTRACT { }
  BODY {
    RETURN(0:u32);
  }
}

NODE @make_zeros [intent: "Allocate a zero-initialized u32 slice in the arena"] {
  SIGNATURE: (count: u64) -> (Slice<u32>);
  EFFECTS: [ARENA];
  CONTRACT {
    PRE: count <= 64;
    POST: len(result) == count;
  }
  BODY {
    %0 = GENERATE(@zero_u32, count);
    RETURN(%0);
  }
}
