module crc32_spec;

NODE @crc32_bit {
  SIGNATURE: (acc: u64, bit_idx: u64) -> (u64);
  EFFECTS: [];
  CONTRACT {
    PRE: acc <= 4294967295;
    POST: result <= 4294967295;
  }
  BODY {
    %0 = AND(acc, 1:u64);
    %1 = NE(%0, 0:u64);
    %2 = SHR.wrap(acc, 1:u32);
    %3 = XOR(%2, 3988292384:u64);
    %4 = SELECT(%1, %3, %2);
    RETURN(%4);
  }
}

NODE @crc32_bit_step {
  SIGNATURE: (crc: u64, byte: u8) -> (u64);
  EFFECTS: [];
  CONTRACT {
    PRE: crc <= 4294967295;
    POST: result <= 4294967295;
    INVARIANT @bit_inv(k, acc): acc <= 4294967295;
  }
  BODY {
    %0 = CAST.u64(byte);
    %1 = XOR(crc, %0);
    %2 = IDENTITY([0, 1, 2, 3, 4, 5, 6, 7]:Array<u64, 8>);
    %3 = FOLD_BOUNDED(@crc32_bit, %2, init=%1, invariant=@bit_inv);
    RETURN(%3);
  }
}

SPEC @crc32_ieee {
  SIGNATURE: (crc: u64, buf: Slice<u8>) -> (u64);
  EFFECTS: [];
  CONTRACT {
    PRE: true;
    POST: result <= 4294967295;
    INVARIANT @crc_inv(k, acc): acc <= 4294967295;
  }
  BODY {
    %0 = AND(crc, 4294967295:u64);
    %1 = XOR(%0, 4294967295:u64);
    %2 = FOLD_BOUNDED(@crc32_bit_step, buf, init=%1, invariant=@crc_inv);
    %3 = XOR(%2, 4294967295:u64);
    RETURN(%3);
  }
}
