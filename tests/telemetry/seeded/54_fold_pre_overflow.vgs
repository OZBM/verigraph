// expect: reject @sum_pre/%0/FOLD.pre.0
// slice-max: 5
module s54_fold_pre_overflow;

NODE @step_tight {
  SIGNATURE: (acc: u32, x: u32) -> (u32);
  EFFECTS: [];
  CONTRACT {
    PRE: acc <= 200 && x <= 100;
    POST: result == acc + x;
  }
  BODY {
    %0 = ADD.checked(acc, x);
    RETURN(%0);
  }
}

NODE @sum_pre {
  SIGNATURE: (xs: Array<u32, 4>) -> (u32);
  EFFECTS: [];
  CONTRACT {
    PRE: forall(i in 0..4) { xs[i] <= 100 };
    INVARIANT @inv(k, acc): acc <= k * 100; // BUG: at k=3, acc=300 > 200
  }
  BODY {
    %0 = FOLD_BOUNDED(@step_tight, xs, init=0:u32, invariant=@inv);
    RETURN(%0);
  }
}
