// expect: reject @guarded_sub/%1/GUARD.then.pre.0
// slice-max: 5
module s58_guard_inverted_cond;

NODE @sub_pos {
  SIGNATURE: (a: u32, b: u32) -> (u32);
  EFFECTS: [];
  CONTRACT {
    PRE: a >= b;
    POST: result == a - b;
  }
  BODY {
    %0 = SUB.checked(a, b);
    RETURN(%0);
  }
}

NODE @fallback_zero {
  SIGNATURE: (a: u32, b: u32) -> (u32);
  EFFECTS: [];
  CONTRACT {}
  BODY { RETURN(0:u32); }
}

NODE @guarded_sub {
  SIGNATURE: (a: u32, b: u32) -> (u32);
  EFFECTS: [];
  CONTRACT {}
  BODY {
    %0 = LT.u(a, b); // BUG: inverted condition sends a < b to @sub_pos
    %1 = ASSERT_GUARD.branch(%0, @sub_pos, a, b, else=@fallback_zero);
    RETURN(%1);
  }
}
