// expect: reject @guarded_div/%1/GUARD.then.pre.0
// slice-max: 5
module s57_guard_weak_then;

NODE @do_div {
  SIGNATURE: (a: u32, b: u32) -> (u32);
  EFFECTS: [];
  CONTRACT {
    PRE: b > 0;
    POST: result <= a;
  }
  BODY {
    %0 = DIV.checked(a, b);
    RETURN(%0);
  }
}

NODE @zero_b {
  SIGNATURE: (a: u32, b: u32) -> (u32);
  EFFECTS: [];
  CONTRACT {}
  BODY { RETURN(0:u32); }
}

NODE @guarded_div {
  SIGNATURE: (a: u32, b: u32) -> (u32);
  EFFECTS: [];
  CONTRACT {}
  BODY {
    %0 = GE.u(b, 0:u32); // BUG: >= 0 instead of > 0
    %1 = ASSERT_GUARD(%0, @do_div, a, b, else=@zero_b);
    RETURN(%1);
  }
}
