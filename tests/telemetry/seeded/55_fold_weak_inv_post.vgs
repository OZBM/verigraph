// expect: reject @sum_post/POST.0
// slice-max: 5
module s55_fold_weak_inv_post;

NODE @step {
  SIGNATURE: (acc: u32, x: u32) -> (u32);
  EFFECTS: [];
  CONTRACT {
    PRE: acc <= 400 && x <= 100;
    POST: result == acc + x;
  }
  BODY {
    %0 = ADD.checked(acc, x);
    RETURN(%0);
  }
}

NODE @sum_post {
  SIGNATURE: (xs: Array<u32, 4>) -> (u32);
  EFFECTS: [];
  CONTRACT {
    PRE: forall(i in 0..4) { xs[i] <= 10 };
    POST: result <= 40;
    INVARIANT @inv(k, acc): acc <= k * 100; // BUG: invariant too weak to imply result <= 40
  }
  BODY {
    %0 = FOLD_BOUNDED(@step, xs, init=0:u32, invariant=@inv);
    RETURN(%0);
  }
}
