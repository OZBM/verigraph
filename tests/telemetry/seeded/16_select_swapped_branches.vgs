// expect: reject @clamp_zero/POST.0
// slice-max: 5
module s16_select_swapped_branches;

NODE @clamp_zero {
  SIGNATURE: (x: i32) -> (i32);
  EFFECTS: [];
  CONTRACT {
    PRE: x >= -100 && x <= 100;
    POST: result >= 0;
  }
  BODY {
    %0 = LT.s(x, 0:i32);
    %1 = SELECT(%0, x, 0:i32); // BUG: returns x when x < 0
    RETURN(%1);
  }
}
