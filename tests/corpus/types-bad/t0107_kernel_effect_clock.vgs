  SIGNATURE: (e: Eff, x: u32) -> (Eff, u32);
  EFFECTS: [CLOCK];
  CONTRACT { }
  BODY {
    RETURN(e, x);
  }
}

NODE @bad {
  SIGNATURE: (xs: Array<u32, 4>) -> (Array<u32, 4>);
