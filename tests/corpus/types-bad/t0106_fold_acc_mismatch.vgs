// expect: VG-T0106
module t0106_fold_acc_mismatch;

NODE @step {
  SIGNATURE: (acc: u32, x: u32) -> (u32);
  EFFECTS: [];
  CONTRACT { }
  BODY {
    %0 = ADD.wrap(acc, x);
    RETURN(%0);
  }
}

NODE @bad {
  SIGNATURE: (xs: Array<u32, 4>) -> (u32);
  EFFECTS: [];
  CONTRACT {
    INVARIANT @inv(k, acc): acc >= 0;
  }
  BODY {
    %0 = FOLD_BOUNDED(@step, xs, init=0:u64, invariant=@inv);
    RETURN(%0);
  }
}
