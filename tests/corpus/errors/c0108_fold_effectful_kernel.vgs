// expect: error VG-C0108 @bad -
module c0108_fold_effectful_kernel;

NODE @step {
  SIGNATURE: (e: Eff, acc: u32, x: u32) -> (Eff, u32);
  EFFECTS: [CLOCK];
  CONTRACT { }
  BODY {
    %0 = ADD.wrap(acc, x);
    RETURN(e, %0);
  }
}

NODE @pure_step {
  SIGNATURE: (acc: u32, x: u32) -> (u32);
  EFFECTS: [];
  CONTRACT { }
  BODY {
    %0 = ADD.wrap(acc, x);
    RETURN(%0);
  }
}

NODE @bad {
  SIGNATURE: (xs: Array<u32, 4>) -> (u32);
  EFFECTS: [];
  CONTRACT {
    INVARIANT @inv(k, acc): acc == fold:step(0:u32, xs, k);
  }
  BODY {
    %0 = FOLD_BOUNDED(@pure_step, xs, init=0:u32, invariant=@inv);
    RETURN(%0);
  }
}
