// expect: error VG-T0110 @bad op 0
module t0110_guard_branch_params;

NODE @b1 {
  SIGNATURE: (x: u32) -> (u32);
  EFFECTS: [];
  CONTRACT { }
  BODY {
    RETURN(x);
  }
}

NODE @b2 {
  SIGNATURE: (x: i32) -> (u32);
  EFFECTS: [];
  CONTRACT { }
  BODY {
    RETURN(0:u32);
  }
}

NODE @bad {
  SIGNATURE: (c: Bool, x: u32) -> (u32);
  EFFECTS: [];
  CONTRACT { }
  BODY {
    %0 = ASSERT_GUARD(c, @b1, x, else=@b2);
    RETURN(%0);
  }
}
