module a14_cast_primitives;

NODE @cast_primitives {
  SIGNATURE: (b: u8, w: u32, flag: Bool, i: i32) -> (u32, u8, u32, f32);
  EFFECTS: [];
  CONTRACT {
    PRE: w <= 255:u32 && w >= 0:u32;
    POST: result.1 <= 255:u8;
  }
  BODY {
    // Reorder independent statements
    %3 = CAST.f32(i);
    // Bind port b through IDENTITY
    %88 = IDENTITY(b);
    %0 = CAST.u32(%88);
    // Duplicate pure op
    %99 = CAST.u32(flag);
    %2 = CAST.u32(flag);
    %1 = CAST.u8(w);
    // Dead pure op (widening u8 to u64)
    %77 = CAST.u64(b);
    RETURN(%0, %1, %99, %3);
  }
}
