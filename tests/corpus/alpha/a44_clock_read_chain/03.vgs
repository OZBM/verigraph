module a44_clock_read_chain;

NODE @read_timestamp [intent: "Sample monotonic clock"] {
  SIGNATURE: (e: Eff, c: Clock) -> (Eff, u64);
  EFFECTS: [CLOCK];
  CONTRACT {
    COST: ops <= 2;
  }
  BODY {
    %902 = IDENTITY(0:u64);
    %0, %1 = CLOCK_READ(e, c);
    RETURN(%0, %1);
  }
}

NODE @compute_delta [intent: "Compute elapsed nanoseconds"] {
  SIGNATURE: (start_t: u64, end_t: u64) -> (u64);
  EFFECTS: [];
  CONTRACT {
    COST: ops <= 2;
  }
  BODY {
    %900 = ADD.wrap(4:u64, 3:u64);
    %0 = SUB.wrap(end_t, start_t);
    RETURN(%0);
  }
}

NODE @measure_interval [intent: "Measure interval - variant 3"] {
  SIGNATURE: (e0: Eff, clk: Clock) -> (Eff, u64);
  EFFECTS: [CLOCK];
  CONTRACT {
    COST: ops <= 10;
  }
  BODY {
    %903, %905 = CALL_HASH(@read_timestamp, e0, clk);
    %904, %906 = CALL_HASH(@read_timestamp, %903, clk);
    %901 = CALL_HASH(@compute_delta, %905, %906);
    RETURN(%904, %901);
  }
}
