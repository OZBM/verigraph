module generate_port_count;

NODE @ramp_step [intent: "Kernel generating floating-point ramp"] {
  SIGNATURE: (idx: u64, base: f32) -> (f32);
  EFFECTS: [];
  CONTRACT {
    PRE: is_finite(base);
    POST: is_finite(result);
  }
  BODY {
    %900 = FMUL(base, 2.0:f32);
    %0 = CAST.f32(idx);
    %1 = FADD(%0, base);
    RETURN(%1);
  }
}

NODE @create_ramp [intent: "Generate dynamic slice with port count", export] {
  SIGNATURE: (count: u64, base: f32) -> (Slice<f32>);
  EFFECTS: [ARENA];
  CONTRACT {
    PRE: is_finite(base);
    COST: arena_bytes <= 4096;
  }
  BODY {
    %7 = IDENTITY(base);
    %0 = GENERATE(@ramp_step, count, %7);
    RETURN(%0);
  }
}
