module a22_multi_node_call;

NODE @math_core [intent: "Compute sum and difference of two floats"] {
  SIGNATURE: (a: f32, b: f32) -> (f32, f32);
  EFFECTS: [];
  CONTRACT {
    PRE: is_finite(a) && is_finite(b);
    POST: is_finite(result.0) && is_finite(result.1);
  }
  BODY {
    %0 = FADD(a, b);
    %1 = FSUB(a, b);
    RETURN(%0, %1);
  }
}

NODE @math_scaler [intent: "Scale sum and difference by factor"] {
  SIGNATURE: (sum_in: f32, diff_in: f32, factor: f32) -> (f32, f32);
  EFFECTS: [];
  CONTRACT {
    PRE: is_finite(sum_in) && is_finite(diff_in) && is_finite(factor);
    POST: is_finite(result.0) && is_finite(result.1);
  }
  BODY {
    %0 = FMUL(sum_in, factor);
    %1 = FMUL(diff_in, factor);
    RETURN(%0, %1);
  }
}

NODE @pipeline_proc [intent: "Pipeline calling math_core and math_scaler"] {
  SIGNATURE: (x: f32, y: f32, scale: f32) -> (f32, f32);
  EFFECTS: [];
  CONTRACT {
    PRE: is_finite(x) && is_finite(y) && is_finite(scale);
    POST: is_finite(result.0) && is_finite(result.1);
  }
  BODY {
    %0, %1 = CALL_HASH(@math_core, x, y);
    %2, %3 = CALL_HASH(@math_scaler, %0, %1, scale);
    RETURN(%2, %3);
  }
}
