module a19_result_ops;

NODE @wrap_and_unwrap [intent: "Wrap value into Ok and unwrap"] {
  SIGNATURE: (val: u32) -> (u32, Bool);
  EFFECTS: [];
  CONTRACT {
    POST: result.0 == val && result.1;
  }
  BODY {
    %0: Result<u32, u8> = OK(val);
    %1 = IS_OK(%0);
    %2 = GET_OK(%0);
    RETURN(%2, %1);
  }
}

NODE @wrap_and_unwrap_err [intent: "Wrap error and unwrap"] {
  SIGNATURE: (err_code: u8) -> (u8, Bool);
  EFFECTS: [];
  CONTRACT {
    POST: result.0 == err_code && !result.1;
  }
  BODY {
    %0: Result<u32, u8> = ERR(err_code);
    %1 = IS_OK(%0);
    %2 = GET_ERR(%0);
    RETURN(%2, %1);
  }
}

NODE @test_results [intent: "Caller calling wrap_and_unwrap via CALL_HASH"] {
  SIGNATURE: (x: u32) -> (u32);
  EFFECTS: [];
  CONTRACT {
    POST: result == x;
  }
  BODY {
    %0, %1 = CALL_HASH(@wrap_and_unwrap, x);
    RETURN(%0);
  }
}
