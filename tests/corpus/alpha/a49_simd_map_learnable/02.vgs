module a49_simd_map_learnable;

NODE @scale_sample [intent: "Kernel to scale one float sample"] {
  SIGNATURE: (x: f32, scale: f32) -> (f32);
  EFFECTS: [];
  CONTRACT {
    PRE: is_finite(x) && is_finite(scale);
    POST: is_finite(result);
  }
  BODY {
    %0 = FMUL(scale, x);
    RETURN(%0);
  }
}

NODE @scale_vector [intent: "SIMD map with learnable parameter variant 2"] {
  SIGNATURE: (samples: Array<f32, 4>) -> (Array<f32, 4>);
  EFFECTS: [];
  CONTRACT {
    COST: heap_bytes == 0 && arena_bytes == 0;
    POST: gain_factor >= 0.1 && gain_factor <= 5.0;
  }
  LEARNABLE {
    gain_factor: f32 in [0.1, 5.0];
  }
  BODY {
    %0 = SIMD_MAP(@scale_sample, samples, gain_factor);
    RETURN(%0);
  }
}

NODE @top_filter [intent: "Apply learnable filter vector"] {
  SIGNATURE: (buf: Array<f32, 4>) -> (Array<f32, 4>);
  EFFECTS: [];
  CONTRACT {
    COST: heap_bytes == 0 && arena_bytes == 0;
  }
  BODY {
    %0 = CALL_HASH(@scale_vector, buf);
    RETURN(%0);
  }
}
