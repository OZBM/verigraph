module a07_neg_modes;

NODE @neg_examples {
  SIGNATURE: (s: i32, u: u32) -> (i32, i32, i32, u32);
  EFFECTS: [];
  CONTRACT {
    PRE: s > -2147483648:i32 && s <= 1000:i32;
    POST: result.0 == -s && result.1 == -s && result.2 == -s;
  }
  BODY {
    // Reordered statements
    %3 = NEG.wrap(u);
    %2 = NEG.sat(s);
    // Bind s through IDENTITY
    %8 = IDENTITY(s);
    %1 = NEG.wrap(%8);
    %0 = NEG.checked(s);
    // Duplicate pure op %0
    %15 = NEG.checked(s);
    // Dead pure op
    %9 = NEG.sat(s);
    RETURN(%15, %1, %2, %3);
  }
}
