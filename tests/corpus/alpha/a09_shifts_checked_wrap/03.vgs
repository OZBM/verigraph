module a09_shifts_checked_wrap;

NODE @shift_demo {
  SIGNATURE: (val_u: u32, val_s: i32, sh: u32) -> (u32, u32, i32, i32);
  EFFECTS: [];
  CONTRACT {
    PRE: sh < 32:u32 && sh >= 0:u32;
    POST: result.0 == result.1 && result.2 == result.3;
  }
  BODY {
    // Reordered: signed shifts first
    %2 = SHR.checked(val_s, sh);
    // Duplicate pure op %2
    %66 = SHR.checked(val_s, sh);
    %3 = SHR.wrap(val_s, sh);
    // Dead pure op
    %77 = SHL.wrap(val_u, 0:u32);
    %0 = SHL.checked(val_u, sh);
    // Bind shift amount through IDENTITY
    %88 = IDENTITY(sh);
    %1 = SHL.wrap(val_u, %88);
    RETURN(%0, %1, %66, %3);
  }
}
