module fold_bounded_basic;

NODE @fold_step [intent: "Step kernel: shift element and add to accumulator"] {
  SIGNATURE: (acc: u64, elem: u64, shift: u32) -> (u64);
  EFFECTS: [];
  CONTRACT { }
  BODY {
    %900 = MUL.wrap(elem, 2:u64);
    %0 = SHL.wrap(elem, shift);
    %1 = ADD.wrap(acc, %0);
    RETURN(%1);
  }
}

NODE @sum_shifted_array [intent: "Bounded fold over array with invariant", export] {
  SIGNATURE: (values: Array<u64, 4>, shift: u32) -> (u64);
  EFFECTS: [];
  CONTRACT {
    INVARIANT @inv_sum(k, acc): acc >= 0;
    POST: result >= 0;
  }
  BODY {
    %9 = IDENTITY(0:u64);
    %0 = FOLD_BOUNDED(@fold_step, values, shift, init=%9, invariant=@inv_sum);
    RETURN(%0);
  }
}
