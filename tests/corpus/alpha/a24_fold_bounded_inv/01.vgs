module a24_fold_bounded_inv;

NODE @accum_step [intent: "Accumulator step adding array element"] {
  SIGNATURE: (acc: u32, x: u32) -> (u32);
  EFFECTS: [];
  CONTRACT {
    PRE: acc <= 100000 && x <= 1000;
  }
  BODY {
    %0 = ADD.wrap(acc, x);
    RETURN(%0);
  }
}

NODE @sum_bounded [intent: "Fold bounded over array with invariant"] {
  SIGNATURE: (items: Array<u32, 4>, initial: u32) -> (u32);
  EFFECTS: [];
  CONTRACT {
    INVARIANT @acc_bound(step_idx, current_acc): current_acc >= 0;
    PRE: initial == 0:u32;
    POST: result >= 0;
  }
  BODY {
    %0 = FOLD_BOUNDED(@accum_step, items, init=initial, invariant=@acc_bound);
    RETURN(%0);
  }
}
