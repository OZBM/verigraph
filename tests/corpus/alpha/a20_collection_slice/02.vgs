module a20_collection_slice;

NODE @sub_slice_len [intent: "Inspect slice and length"] {
  SIGNATURE: (arr: Array<u32, 4>) -> (u64);
  EFFECTS: [];
  CONTRACT {
    POST: result == 2;
  }
  BODY {
    %10 = SLICE(arr, 1:u64, 3:u64);
    %11 = LEN(%10);
    RETURN(%11);
  }
}

NODE @combine_arrays [intent: "Variant with reordered index and renamed ports"] {
  SIGNATURE: (xs: Array<u32, 4>) -> (Array<u32, 8>, u64);
  EFFECTS: [];
  CONTRACT {
    PRE: forall(i in 0..4) { xs[i] < 100 };
    POST: forall(i in 0..8) { result.0[i] <= 100 };
  }
  BODY {
    %10 = IDENTITY([10, 20, 30, 40]:Array<u32, 4>);
    %12 = INDEX(xs, 0:u64);
    %11 = CALL_HASH(@sub_slice_len, xs);
    %13 = UPDATE(xs, 0:u64, 99:u32);
    %14 = CONCAT(%13, %10);
    RETURN(%14, %11);
  }
}
