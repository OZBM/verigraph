module a17_cast_float;

NODE @convert_num [intent: "Convert between float and int types"] {
  SIGNATURE: (in_f32: f32, in_u32: u32) -> (f64, i32);
  EFFECTS: [];
  CONTRACT {
    PRE: is_finite(in_f32) && in_f32 >= -1000.0 && in_f32 <= 1000.0;
    POST: is_finite(result.0);
  }
  BODY {
    %0 = CAST.f64(in_f32);
    %1 = CAST.f32(in_u32);
    %2 = FADD(in_f32, %1);
    %3 = CAST.i32(%2);
    %4 = FMUL(%0, 2.0:f64);
    RETURN(%4, %3);
  }
}
