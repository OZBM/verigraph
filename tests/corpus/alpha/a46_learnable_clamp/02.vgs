module a46_learnable_clamp;

NODE @linear_step [intent: "Evaluate linear step with FMA"] {
  SIGNATURE: (x: f32, m: f32, b: f32) -> (f32);
  EFFECTS: [];
  CONTRACT {
    PRE: is_finite(x) && is_finite(m) && is_finite(b);
    POST: is_finite(result);
  }
  BODY {
    %0 = FMA(m, x, b);
    RETURN(%0);
  }
}

NODE @model_layer [intent: "Learnable model layer variant 2"] {
  SIGNATURE: (in_val: f32) -> (f32);
  EFFECTS: [];
  CONTRACT {
    PRE: is_finite(in_val);
    POST: is_finite(result) && w_param >= 0.5 && w_param <= 2.0 && b_param >= -1.0 && b_param <= 1.0;
  }
  LEARNABLE {
    w_param: f32 in [0.5, 2.0];
    b_param: f32 in [-1.0, 1.0];
  }
  BODY {
    %0 = CALL_HASH(@linear_step, in_val, w_param, b_param);
    %1 = FCLAMP(%0, -10.0:f32, 10.0:f32);
    RETURN(%1);
  }
}

NODE @evaluate_layer [intent: "Top level layer evaluator"] {
  SIGNATURE: (sample: f32) -> (f32);
  EFFECTS: [];
  CONTRACT {
    PRE: is_finite(sample);
  }
  BODY {
    %0 = CALL_HASH(@model_layer, sample);
    RETURN(%0);
  }
}
