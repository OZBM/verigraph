module a26_assert_guard_branch;

NODE @pos_branch [intent: "Handle non-negative with swapped add"] {
  SIGNATURE: (x: i32) -> (i32);
  EFFECTS: [];
  CONTRACT {
    PRE: x >= 0;
  }
  BODY {
    %10 = ADD.checked(1:i32, x);
    RETURN(%10);
  }
}

NODE @neg_branch [intent: "Handle negative case"] {
  SIGNATURE: (x: i32) -> (i32);
  EFFECTS: [];
  CONTRACT {
    PRE: x < 0;
  }
  BODY {
    %10 = NEG.sat(x);
    RETURN(%10);
  }
}

NODE @route_guard [intent: "Guard dispatch with renamed branches"] {
  SIGNATURE: (val: i32) -> (i32);
  EFFECTS: [];
  CONTRACT {
    PRE: val > -1000 && val < 1000;
    POST: result >= 0;
  }
  BODY {
    %10 = GE.s(val, 0:i32);
    %11 = ASSERT_GUARD.branch(%10, @pos_branch, val, else=@neg_branch);
    RETURN(%11);
  }
}
