module a53_collections_slice_concat;

NODE @make_and_update [intent: "Initialize array and update elements"] {
  SIGNATURE: (elem0: u32, elem1: u32) -> (Array<u32, 2>);
  EFFECTS: [];
  CONTRACT {
    POST: len(result) == 2;
  }
  BODY {
    %901 = ADD.wrap(elem0, 0:u32);
    %900 = IDENTITY([0, 0]:Array<u32, 2>);
    %0 = UPDATE(%900, 0:u64, elem0);
    %1 = UPDATE(%0, 1:u64, elem1);
    RETURN(%1);
  }
}

NODE @join_and_slice [intent: "Concat arrays and slice view"] {
  SIGNATURE: (a: Array<u32, 2>, b: Array<u32, 2>) -> (Slice<u32>);
  EFFECTS: [];
  CONTRACT {
    POST: len(result) == 3;
  }
  BODY {
    %902 = IDENTITY(0:u64);
    %10 = CONCAT(a, b);
    %11 = LEN(%10);
    %12 = SLICE(%10, %902, 3:u64);
    RETURN(%12);
  }
}

NODE @process_bytes [intent: "Convert sliced elements to bytes view variant 2"] {
  SIGNATURE: (x: u32, y: u32) -> (Slice<u8>);
  EFFECTS: [];
  CONTRACT {
    POST: len(result) > 0;
  }
  BODY {
    %0 = CALL_HASH(@make_and_update, x, y);
    %1 = CALL_HASH(@join_and_slice, %0, %0);
    %2 = AS_BYTES(%1);
    RETURN(%2);
  }
}
