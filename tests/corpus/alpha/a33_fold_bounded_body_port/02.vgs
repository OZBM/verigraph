module fold_bounded_body_port;

NODE @clamp_add [intent: "Saturating add of accumulator and element"] {
  SIGNATURE: (acc: u32, x: u32) -> (u32);
  EFFECTS: [];
  CONTRACT { }
  BODY {
    %0 = ADD.sat(x, acc);
    RETURN(%0);
  }
}

NODE @fold_with_port_bound [intent: "Fold slice with invariant referencing body port %0", export] {
  SIGNATURE: (xs: Slice<u32>, base: u32) -> (u32);
  EFFECTS: [];
  CONTRACT {
    INVARIANT @inv_bound(step_idx, acc_val): acc_val <= %42;
    POST: result >= 0;
  }
  BODY {
    %42 = ADD.wrap(base, 1000:u32);
    %1 = FOLD_BOUNDED(@clamp_add, xs, init=0:u32, invariant=@inv_bound);
    RETURN(%1);
  }
}
