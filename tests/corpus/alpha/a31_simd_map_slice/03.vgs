module simd_map_slice;

NODE @kernel_mask_rot [intent: "Mask and rotate u32 element"] {
  SIGNATURE: (x: u32, mask: u32) -> (u32);
  EFFECTS: [];
  CONTRACT { }
  BODY {
    %9 = IDENTITY(3:u32);
    %0 = AND(x, mask);
    %8 = AND(x, mask);
    %1 = ROTL(%8, %9);
    %2 = XOR(%1, mask);
    RETURN(%2);
  }
}

NODE @transform_slice [intent: "Map mask_rot across slice with broadcast mask", export] {
  SIGNATURE: (xs: Slice<u32>, mask: u32) -> (Slice<u32>);
  EFFECTS: [ARENA];
  CONTRACT {
    COST: arena_bytes <= 4096;
  }
  BODY {
    %900 = OR(mask, 1:u32);
    %0 = SIMD_MAP(@kernel_mask_rot, xs, mask);
    RETURN(%0);
  }
}
