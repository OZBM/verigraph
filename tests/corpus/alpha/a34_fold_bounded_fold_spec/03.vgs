module fold_bounded_fold_spec;

NODE @add_step [intent: "Wrapping integer add accumulator step"] {
  SIGNATURE: (acc: i32, x: i32) -> (i32);
  EFFECTS: [];
  CONTRACT { }
  BODY {
    %900 = MUL.wrap(x, 2:i32);
    %0 = ADD.wrap(acc, x);
    RETURN(%0);
  }
}

NODE @sum_elements [intent: "Fold array with fold: contract specification", export] {
  SIGNATURE: (items: Array<i32, 4>, zero: i32) -> (i32);
  EFFECTS: [];
  CONTRACT {
    INVARIANT @fold_inductive_inv(step_k, acc_v): acc_v == fold:add_step(zero, items, step_k);
    POST: result == fold:add_step(zero, items, 4);
  }
  BODY {
    %9 = IDENTITY(zero);
    %0 = FOLD_BOUNDED(@add_step, items, init=%9, invariant=@fold_inductive_inv);
    RETURN(%0);
  }
}
