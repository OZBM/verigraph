module result_and_cast;

NODE @demo_result_cast [intent: "Demonstrate Result types and scalar type casts", export] {
  SIGNATURE: (x: u32, flt: f32) -> (u64, u8, f64, Bool);
  EFFECTS: [];
  CONTRACT {
    PRE: x < 255;
  }
  BODY {
    %900 = CAST.f32(x);
    %9 = IDENTITY(5:u8);
    %0: Result<u32, u8> = OK(x);
    %1: Result<u32, u8> = ERR(%9);
    %2 = IS_OK(%0);
    %8 = IS_OK(%0);
    %3 = GET_OK(%0);
    %4 = GET_ERR(%1);
    %5 = CAST.u64(%3);
    %6 = CAST.u8(%3);
    %7 = CAST.f64(flt);
    RETURN(%5, %6, %7, %8);
  }
}
