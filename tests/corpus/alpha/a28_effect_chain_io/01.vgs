module a28_effect_chain_io;

NODE @timed_file_transfer [intent: "Read from file, record time, and write to file"] {
  SIGNATURE: (e: Eff, fin: FileIn, fout: FileOut, clk: Clock, payload: Slice<u8>) -> (Eff, Result<u64, u32>, u64);
  EFFECTS: [ARENA, CLOCK, FILE_READ, FILE_WRITE];
  CONTRACT {}
  BODY {
    %0, %1 = CLOCK_READ(e, clk);
    %2, %3 = FILE_READ(%0, fin, 512:u64);
    %4, %5 = FILE_WRITE(%2, fout, payload);
    RETURN(%4, %5, %1);
  }
}
