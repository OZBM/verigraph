module assert_guard_basic;

NODE @div_zero [intent: "Fallback division returning zero"] {
  SIGNATURE: (x: i32, denom: i32) -> (i32);
  EFFECTS: [];
  CONTRACT { }
  BODY {
    %0 = IDENTITY(0:i32);
    RETURN(%0);
  }
}

NODE @div_checked [intent: "Checked division when denominator is non-zero"] {
  SIGNATURE: (x: i32, denom: i32) -> (i32);
  EFFECTS: [];
  CONTRACT {
    PRE: denom != 0;
  }
  BODY {
    %0 = DIV.checked(x, denom);
    RETURN(%0);
  }
}

NODE @guarded_division [intent: "Guarded division dispatcher", export] {
  SIGNATURE: (x: i32, denom: i32) -> (i32);
  EFFECTS: [];
  CONTRACT { }
  BODY {
    %900 = ADD.wrap(x, 1:i32);
    %9 = IDENTITY(0:i32);
    %0 = NE(denom, %9);
    %1 = ASSERT_GUARD(%0, @div_checked, x, denom, else=@div_zero);
    RETURN(%1);
  }
}
