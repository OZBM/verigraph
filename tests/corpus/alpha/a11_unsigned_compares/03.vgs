module a11_unsigned_compares;

NODE @unsigned_cmp {
  SIGNATURE: (a: u32, b: u32) -> (Bool, Bool, Bool, Bool, Bool, Bool);
  EFFECTS: [];
  CONTRACT {
    PRE: a == b;
    POST: result.0 && result.1 && result.2 && !result.3 && !result.4 && !result.5;
  }
  BODY {
    // Reordered independent comparisons
    %3 = NE(a, b);
    %4 = LT.u(a, b);
    // Bind b via IDENTITY
    %88 = IDENTITY(b);
    %5 = GT.u(a, %88);
    // Duplicate pure op
    %77 = EQ(a, b);
    // Dead pure op
    %99 = EQ(a, 0:u32);
    %0 = EQ(a, b);
    %1 = LE.u(a, b);
    %2 = GE.u(a, b);
    RETURN(%77, %1, %2, %3, %4, %5);
  }
}
