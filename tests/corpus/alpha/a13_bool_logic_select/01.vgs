module a13_bool_logic_select;

NODE @bool_select {
  SIGNATURE: (cond1: Bool, cond2: Bool, val_t: u32, val_f: u32) -> (Bool, Bool, Bool, u32);
  EFFECTS: [];
  CONTRACT {
    PRE: cond1 == true;
    POST: result.3 == val_t;
  }
  BODY {
    %0 = BAND(cond1, cond2);
    %1 = BOR(cond1, cond2);
    %2 = BNOT(cond1);
    %3 = SELECT(cond1, val_t, val_f);
    RETURN(%0, %1, %2, %3);
  }
}
