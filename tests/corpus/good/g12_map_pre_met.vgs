// expect: verify
module g12_map_pre_met;

NODE @inc {
  SIGNATURE: (x: u32) -> (u32);
  EFFECTS: [];
  CONTRACT {
    PRE: x < 100;
    POST: result == x + 1;
  }
  BODY {
    %0 = ADD.checked(x, 1:u32);
    RETURN(%0);
  }
}

NODE @f {
  SIGNATURE: (xs: Array<u32, 3>) -> (Array<u32, 3>);
  EFFECTS: [];
  CONTRACT {
    PRE: forall(i in 0..3) { xs[i] < 50 };
    POST: forall(i in 0..3) { result[i] == xs[i] + 1 };
  }
  BODY {
    %0 = SIMD_MAP(@inc, xs);
    RETURN(%0);
  }
}
