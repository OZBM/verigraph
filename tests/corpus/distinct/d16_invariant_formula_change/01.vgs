// 01: Invariant formula checks acc >= 0
module d16_invariant_formula_change;

NODE @step {
  SIGNATURE: (acc: u32, x: u32) -> (u32);
  EFFECTS: [];
  CONTRACT { }
  BODY {
    %0 = ADD.wrap(acc, x);
    RETURN(%0);
  }
}

NODE @sum_all {
  SIGNATURE: (arr: Array<u32, 4>) -> (u32);
  EFFECTS: [];
  CONTRACT {
    INVARIANT @inv(k, acc): acc >= 0;
  }
  BODY {
    %0 = FOLD_BOUNDED(@step, arr, init=0:u32, invariant=@inv);
    RETURN(%0);
  }
}
