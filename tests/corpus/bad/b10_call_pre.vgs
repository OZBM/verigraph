    PRE: x < 10;
    POST: result == x + 1;
  }
  BODY {
    %0 = ADD.checked(x, 1:u32);
    RETURN(%0);
  }
}

NODE @f {
  SIGNATURE: (x: u32) -> (u32);
  EFFECTS: [];
