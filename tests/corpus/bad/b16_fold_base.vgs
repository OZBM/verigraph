// expect: reject @sum/%0/FOLD.base
module b16_fold_base;

NODE @step {
  SIGNATURE: (acc: u32, x: u32) -> (u32);
  EFFECTS: [];
  CONTRACT { PRE: acc <= 3000 && x <= 1000; POST: result == acc + x; }
  BODY { %0 = ADD.checked(acc, x); RETURN(%0); }
}

// The invariant asks for acc >= 1 before the first step, but the fold starts at 0.
NODE @sum {
  SIGNATURE: (xs: Array<u32, 4>) -> (u32);
  EFFECTS: [];
  CONTRACT {
    PRE: forall(i in 0..4) { xs[i] <= 1000 };
    INVARIANT @bounded(k, acc): acc >= 1 && acc <= 1000 * k + 1;
  }
  BODY {
    %0 = FOLD_BOUNDED(@step, xs, init=0:u32, invariant=@bounded);
    RETURN(%0);
  }
}
