// expect: reject @f/POST.0.wd.0
module b21_post_wd;

// POST divides by the result, which is zero whenever x's low byte is: the formula is not defined
// there (ADR 0010).
NODE @f {
  SIGNATURE: (x: u32) -> (u32);
  EFFECTS: [];
  CONTRACT { POST: x / result >= 0; }
  BODY {
    %0 = AND(x, 255:u32);
    RETURN(%0);
  }
}
