// expect: reject @sum/%0/FOLD.pre.0
module b17_fold_pre;

NODE @step {
  SIGNATURE: (acc: u32, x: u32) -> (u32);
  EFFECTS: [];
  CONTRACT { PRE: acc <= 1500 && x <= 1000; POST: result == acc + x; }
  BODY { %0 = ADD.checked(acc, x); RETURN(%0); }
}

// Every element is 1000, so after two steps acc is 2000, past the step's PRE; the invariant
// says so, and still the fold calls the step.
NODE @sum {
  SIGNATURE: (xs: Array<u32, 4>) -> (u32);
  EFFECTS: [];
  CONTRACT {
    PRE: forall(i in 0..4) { xs[i] == 1000 };
    INVARIANT @bounded(k, acc): acc == 1000 * k;
  }
  BODY {
    %0 = FOLD_BOUNDED(@step, xs, init=0:u32, invariant=@bounded);
    RETURN(%0);
  }
}
