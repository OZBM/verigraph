// expect: reject @f/%4/GET_ERR.is_err
module b14_get_err_is_err;

// GET_ERR on a Result that is Ok for x < 10.
NODE @f {
  SIGNATURE: (x: u8) -> (u8);
  EFFECTS: [];
  CONTRACT { }
  BODY {
    %0: Result<u8, u8> = OK(x);
    %1: Result<u8, u8> = ERR(x);
    %2 = LT.u(x, 10:u8);
    %3 = SELECT(%2, %0, %1);
    %4 = GET_ERR(%3);
    RETURN(%4);
  }
}
