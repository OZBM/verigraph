// Grader reference contract for @sanitize_f32.
// The grader proves the candidate refines it through a wrapper CALL_HASH:
// PRE_ref => PRE_cand and PRE_ref /\ POST_cand => POST_ref.
module sanitize_f32_contract;

@MESH_QUERY @sanitize_f32 {
  signature: (f32, f32) -> (f32);
  effects: [];
  pre: is_finite(arg1);
  post: is_finite(result) && (is_finite(arg0) ==> same(result, arg0)) && (!is_finite(arg0) ==> same(result, arg1));
  intent: "Float sanitization for NaN and +/-inf with same()";
}
