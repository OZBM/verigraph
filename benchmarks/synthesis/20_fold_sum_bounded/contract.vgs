// Grader reference contract for @fold_sum_bounded.
// The grader proves the candidate refines it through a wrapper CALL_HASH:
// PRE_ref => PRE_cand and PRE_ref /\ POST_cand => POST_ref.
module fold_sum_bounded_contract;

NODE @sum_step {
  SIGNATURE: (acc: u32, x: u32) -> (u32);
  EFFECTS: [];
  CONTRACT {
    PRE: acc <= 700000 && x <= 100000;
    POST: result == acc + x;
  }
  BODY {
    %0 = ADD.checked(acc, x);
    RETURN(%0);
  }
}

@MESH_QUERY @fold_sum_bounded {
  signature: (Array<u32, 8>) -> (u32);
  effects: [];
  pre: forall(i in 0..8) { arg0[i] <= 100000 };
  post: result == fold:sum_step(0:u32, arg0, 8) && result <= 800000;
  intent: "FOLD_BOUNDED exact sum over Array<u32, 8> with INVARIANT and fold:";
}
