// expect: verify
// run: @safe_div_i32 {"x": 17, "d": 5} => [3]
// run: @safe_div_i32 {"x": -17, "d": 0} => [0]
module safe_div_i32;

NODE @safe_div_i32 [intent: "Signed i32 division returning 0 on zero divisor"] {
  SIGNATURE: (x: i32, d: i32) -> (i32);
  EFFECTS: [];
  CONTRACT {
    PRE: !(x == -2147483648 && d == -1);
    POST: (d == 0 ==> result == 0) && (d == 1 ==> result == x) && (d == -1 ==> result == -x) && (x == 0 ==> result == 0) && (d > 0 && x >= 0 ==> result >= 0 && result <= x) && (d > 0 && x <= 0 ==> result <= 0 && result >= x) && (d < 0 && x >= 0 ==> result <= 0 && -result <= x) && (d < 0 && x <= 0 ==> result >= 0 && result <= -x);
  }
  BODY {
    %0 = NE(d, 0:i32);
    %1 = SELECT(%0, d, 1:i32);
    %2 = DIV.checked(x, %1);
    %3 = SELECT(%0, %2, 0:i32);
    RETURN(%3);
  }
}
