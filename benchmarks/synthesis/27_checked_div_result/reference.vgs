// expect: verify
// run: @checked_div_result {"a": 20, "b": 4} => [{"ok": 5}]
// run: @checked_div_result {"a": 20, "b": 0} => [{"err": 1}]
module checked_div_result;

NODE @do_div {
  SIGNATURE: (a: u32, b: u32) -> (Result<u32, u32>);
  EFFECTS: [];
  CONTRACT {
    PRE: b != 0;
    POST: is_ok(result) && ok(result) <= a && (b == 1 ==> ok(result) == a) && (b > a ==> ok(result) == 0);
  }
  BODY {
    %0 = DIV.checked(a, b);
    %1: Result<u32, u32> = OK(%0);
    RETURN(%1);
  }
}

NODE @div_zero_err {
  SIGNATURE: (a: u32, b: u32) -> (Result<u32, u32>);
  EFFECTS: [];
  CONTRACT {
    POST: !is_ok(result) && err(result) == 1;
  }
  BODY {
    %0: Result<u32, u32> = ERR(1:u32);
    RETURN(%0);
  }
}

NODE @checked_div_result [intent: "Unsigned u32 division returning Result<u32, u32>"] {
  SIGNATURE: (a: u32, b: u32) -> (Result<u32, u32>);
  EFFECTS: [];
  CONTRACT {
    POST: (b != 0 ==> is_ok(result) && ok(result) <= a) && (b == 1 ==> ok(result) == a) && (b > a ==> ok(result) == 0) && (b == 0 ==> !is_ok(result) && err(result) == 1);
  }
  BODY {
    %0 = NE(b, 0:u32);
    %1 = ASSERT_GUARD.branch(%0, @do_div, a, b, else=@div_zero_err);
    RETURN(%1);
  }
}
