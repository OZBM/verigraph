// Grader reference contract for @wrap_add_u16.
// The grader proves the candidate refines it through a wrapper CALL_HASH:
// PRE_ref => PRE_cand and PRE_ref /\ POST_cand => POST_ref.
module wrap_add_u16_contract;

@MESH_QUERY @wrap_add_u16 {
  signature: (u16, u16) -> (u16);
  effects: [];
  post: result == (arg0 + arg1) % 65536 && (arg0 + arg1 < 65536 ==> result == arg0 + arg1);
  intent: "Wrapping u16 modular addition (ADD.wrap)";
}
