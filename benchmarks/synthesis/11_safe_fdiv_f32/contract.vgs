// Grader reference contract for @safe_fdiv_f32.
// The grader proves the candidate refines it through a wrapper CALL_HASH:
// PRE_ref => PRE_cand and PRE_ref /\ POST_cand => POST_ref.
module safe_fdiv_f32_contract;

@MESH_QUERY @safe_fdiv_f32 {
  signature: (f32, f32) -> (f32);
  effects: [];
  post: is_finite(result) && ((!is_finite(arg0) || !is_finite(arg1) || arg1 == 0.0) ==> result == 0.0);
  intent: "Finite-preserving float division handling 0, NaN, inf, and overflow";
}
