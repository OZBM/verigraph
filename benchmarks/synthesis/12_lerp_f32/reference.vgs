// expect: verify
// run: @lerp_f32 {"a": "0.0", "b": "10.0", "t": "0.25"} => ["2.5"]
// run: @lerp_f32 {"a": "10.0", "b": "2.0", "t": "0.0"} => ["10.0"]
module lerp_f32;

NODE @lerp_f32 [intent: "Bounded linear interpolation between a and b at t in [0, 1]"] {
  SIGNATURE: (a: f32, b: f32, t: f32) -> (f32);
  EFFECTS: [];
  CONTRACT {
    PRE: is_finite(a) && is_finite(b) && is_finite(t) && t >= 0.0 && t <= 1.0 && abs(a) <= 10000000000.0 && abs(b) <= 10000000000.0;
    POST: is_finite(result) && result >= min(a, b) && result <= max(a, b) && (t == 0.0 ==> result == a);
  }
  BODY {
    %0 = FSUB(b, a);
    %1 = FMA(%0, t, a);
    %2 = FMIN(a, b);
    %3 = FMAX(a, b);
    %4 = FCLAMP(%1, %2, %3);
    RETURN(%4);
  }
}
