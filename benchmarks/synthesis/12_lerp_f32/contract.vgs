// Grader reference contract for @lerp_f32.
// The grader proves the candidate refines it through a wrapper CALL_HASH:
// PRE_ref => PRE_cand and PRE_ref /\ POST_cand => POST_ref.
module lerp_f32_contract;

@MESH_QUERY @lerp_f32 {
  signature: (f32, f32, f32) -> (f32);
  effects: [];
  pre: is_finite(arg0) && is_finite(arg1) && is_finite(arg2) && arg2 >= 0.0 && arg2 <= 1.0 && abs(arg0) <= 10000000000.0 && abs(arg1) <= 10000000000.0;
  post: is_finite(result) && result >= min(arg0, arg1) && result <= max(arg0, arg1) && (arg2 == 0.0 ==> result == arg0);
  intent: "Bounded FMA linear interpolation clamped into [min(a,b), max(a,b)]";
}
