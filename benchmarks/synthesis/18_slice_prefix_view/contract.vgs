// Grader reference contract for @slice_prefix_view.
// The grader proves the candidate refines it through a wrapper CALL_HASH:
// PRE_ref => PRE_cand and PRE_ref /\ POST_cand => POST_ref.
module slice_prefix_view_contract;

@MESH_QUERY @slice_prefix_view {
  signature: (Slice<u8>, u64) -> (Slice<u8>);
  effects: [];
  post: len(result) == min(arg1, len(arg0)) && forall(i in 0..len(result)) { result[i] == arg0[i] };
  intent: "Zero-allocation Slice prefix view (LEN, LT.u, SELECT, SLICE)";
}
