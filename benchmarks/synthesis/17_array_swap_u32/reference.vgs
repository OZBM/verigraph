// expect: verify
// run: @array_swap_u32 {"xs": [1, 2, 3, 4], "i": "0", "j": "3"} => [[4, 2, 3, 1]]
// run: @array_swap_u32 {"xs": [1, 2, 3, 4], "i": "2", "j": "2"} => [[1, 2, 3, 4]]
module array_swap_u32;

NODE @array_swap_u32 [intent: "Swap elements i and j of a 4-element u32 array"] {
  SIGNATURE: (xs: Array<u32, 4>, i: u64, j: u64) -> (Array<u32, 4>);
  EFFECTS: [];
  CONTRACT {
    PRE: i < 4 && j < 4;
    POST: result[i] == xs[j] && result[j] == xs[i] && forall(k in 0..4) { (k != i && k != j) ==> result[k] == xs[k] };
  }
  BODY {
    %0 = INDEX(xs, i);
    %1 = INDEX(xs, j);
    %2 = UPDATE(xs, i, %1);
    %3 = UPDATE(%2, j, %0);
    RETURN(%3);
  }
}
