// expect: verify
// run: @fold_count_above {"xs": ["-1.0", "0.5", "2.0", "nan"], "thr": "0.0"} => [2]
// run: @fold_count_above {"xs": [], "thr": "0.0"} => [0]
module fold_count_above;

NODE @count_step {
  SIGNATURE: (acc: u32, x: f32, thr: f32) -> (u32);
  EFFECTS: [];
  CONTRACT {
    PRE: acc < 4294967295;
    POST: (x > thr ==> result == acc + 1) && (!(x > thr) ==> result == acc);
  }
  BODY {
    %0 = GT.f(x, thr);
    %1 = SELECT(%0, 1:u32, 0:u32);
    %2 = ADD.checked(acc, %1);
    RETURN(%2);
  }
}

NODE @fold_count_above [intent: "Count f32 slice elements strictly above thr"] {
  SIGNATURE: (xs: Slice<f32>, thr: f32) -> (u32);
  EFFECTS: [];
  CONTRACT {
    PRE: len(xs) < 4294967295;
    POST: result == fold:count_step(0:u32, xs, len(xs), thr) && result <= len(xs);
    INVARIANT @count_inv(k, acc): acc == fold:count_step(0:u32, xs, k, thr) && acc <= k;
  }
  BODY {
    %0 = FOLD_BOUNDED(@count_step, xs, thr, init=0:u32, invariant=@count_inv);
    RETURN(%0);
  }
}
