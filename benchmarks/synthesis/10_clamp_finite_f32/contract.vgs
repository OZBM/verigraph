// Grader reference contract for @clamp_finite_f32.
// The grader proves the candidate refines it through a wrapper CALL_HASH:
// PRE_ref => PRE_cand and PRE_ref /\ POST_cand => POST_ref.
module clamp_finite_f32_contract;

@MESH_QUERY @clamp_finite_f32 {
  signature: (f32, f32, f32) -> (f32);
  effects: [];
  pre: is_finite(arg1) && is_finite(arg2) && arg1 <= arg2;
  post: is_finite(result) && result >= arg1 && result <= arg2 && (is_nan(arg0) ==> result == arg1) && (!is_nan(arg0) && arg0 < arg1 ==> result == arg1) && (!is_nan(arg0) && arg0 > arg2 ==> result == arg2) && (!is_nan(arg0) && arg0 >= arg1 && arg0 <= arg2 ==> result == arg0);
  intent: "FCLAMP with NaN handling into finite bounds";
}
