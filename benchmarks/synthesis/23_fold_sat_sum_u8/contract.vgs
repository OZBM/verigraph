// Grader reference contract for @fold_sat_sum_u8.
// The grader proves the candidate refines it through a wrapper CALL_HASH:
// PRE_ref => PRE_cand and PRE_ref /\ POST_cand => POST_ref.
module fold_sat_sum_u8_contract;

NODE @sat_step {
  SIGNATURE: (acc: u8, x: u8) -> (u8);
  EFFECTS: [];
  CONTRACT {
    POST: result >= acc && result >= x && (acc + x <= 255 ==> result == acc + x) && (acc + x > 255 ==> result == 255);
  }
  BODY {
    %0 = ADD.sat(acc, x);
    RETURN(%0);
  }
}

@MESH_QUERY @fold_sat_sum_u8 {
  signature: (Slice<u8>) -> (u8);
  effects: [];
  post: result == fold:sat_step(0:u8, arg0, len(arg0)) && (len(arg0) == 0 ==> result == 0) && forall(i in 0..len(arg0)) { result >= arg0[i] };
  intent: "FOLD_BOUNDED saturating byte sum over Slice<u8>";
}
