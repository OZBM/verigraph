// expect: verify
// A 256 x 256 f32 matrix product, row-major, each cell summed in k order with no contraction, so
// the C reference computes the very same floats: a benchmark kernel of docs/06 and docs/16.
module bench_matmul;

NODE @iota [intent: "The index itself, as the step count of a cell's sum"] {
  SIGNATURE: (k: u64) -> (u64);
  EFFECTS: [];
  CONTRACT {
    PRE: k < 256;
    POST: result == k;
  }
  BODY {
    RETURN(k);
  }
}

// acc + a[row, k] * b[k, col]. Every index is below 65536 because row, k and col are below 256.
NODE @mac [intent: "One multiply-add of a cell's dot product"] {
  SIGNATURE: (acc: f32, k: u64, a: Array<f32, 65536>, b: Array<f32, 65536>, row: u64, col: u64) -> (f32);
  EFFECTS: [];
  CONTRACT {
    PRE: k < 256 && row < 256 && col < 256;
  }
  BODY {
    %0 = MUL.checked(row, 256:u64);
    %1 = ADD.checked(%0, k);
    %2 = INDEX(a, %1);
    %3 = MUL.checked(k, 256:u64);
    %4 = ADD.checked(%3, col);
    %5 = INDEX(b, %4);
    %6 = FMUL(%2, %5);
    %7 = FADD(acc, %6);
    RETURN(%7);
  }
}

NODE @cell [intent: "Cell i of the product"] {
  SIGNATURE: (i: u64, a: Array<f32, 65536>, b: Array<f32, 65536>) -> (f32);
  EFFECTS: [];
  CONTRACT {
    PRE: i < 65536;
    INVARIANT @any(k, acc): k <= 256;
  }
  BODY {
    %0 = DIV.checked(i, 256:u64);
    %1 = MOD.checked(i, 256:u64);
    %2 = GENERATE(@iota, 256:u64);
    %3 = FOLD_BOUNDED(@mac, %2, a, b, %0, %1, init=0.0:f32, invariant=@any);
    RETURN(%3);
  }
}

NODE @matmul [intent: "The product of two 256 x 256 f32 matrices, row-major", export] {
  SIGNATURE: (a: Array<f32, 65536>, b: Array<f32, 65536>) -> (Array<f32, 65536>);
  EFFECTS: [];
  CONTRACT { }
  BODY {
    %0 = GENERATE(@cell, 65536:u64, a, b);
    RETURN(%0);
  }
}
