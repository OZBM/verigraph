// expect: verify
// A verified fractal renderer: the Mandelbrot set by escape time, 256 x 192 pixels.
// Each pixel is a u32 whose little-endian bytes are red, green, blue and alpha, so the result is
// an RGBA image as it is: a browser canvas takes the 196,608 output bytes directly.
module mandelbrot;

// A step of the escape loop. The loop walks a 64-element array, one element per step, so it has
// a bound the verifier can see; the element itself carries nothing.
NODE @tick [intent: "One step of the escape loop's counter array"] {
  SIGNATURE: (k: u64) -> (u8);
  EFFECTS: [];
  CONTRACT { }
  BODY {
    RETURN(0:u8);
  }
}

// z <- z^2 + c while |z| <= 2, counting the steps taken. Once z escapes it stays put, so the count
// is the escape time. The tuple is (re z, im z, count).
NODE @escape_step [intent: "One Mandelbrot iteration that freezes once the point escapes"] {
  SIGNATURE: (z: Tuple<f32, f32, u32>, t: u8, cr: f32, ci: f32) -> (Tuple<f32, f32, u32>);
  EFFECTS: [];
  CONTRACT {
    PRE: z.2 < 64;
    POST: result.2 <= z.2 + 1;
  }
  BODY {
    %0 = PROJ(z, 0:u32);
    %1 = PROJ(z, 1:u32);
    %2 = PROJ(z, 2:u32);
    %3 = FMUL(%0, %0);
    %4 = FMUL(%1, %1);
    %5 = FADD(%3, %4);
    %6 = LE.f(%5, 4.0:f32);
    %7 = FSUB(%3, %4);
    %8 = FADD(%7, cr);
    %9 = FMUL(%0, %1);
    %10 = FADD(%9, %9);
    %11 = FADD(%10, ci);
    %12 = ADD.checked(%2, 1:u32);
    %13 = SELECT(%6, %8, %0);
    %14 = SELECT(%6, %11, %1);
    %15 = SELECT(%6, %12, %2);
    %16 = TUPLE(%13, %14, %15);
    RETURN(%16);
  }
}

// One palette colour, j of 16: three polynomial ramps in t = (j + 0.5) / 16, scaled to bytes. Each
// channel goes from float to u8 through CAST, whose obligation is that the value fits a byte: the
// verifier proves 255 * 9 (1 - t) t^3 and the other two ramps never leave [0, 255].
NODE @palette_entry [intent: "Colour j of a 16-entry gradient palette, opaque"] {
  SIGNATURE: (j: u64) -> (u32);
  EFFECTS: [];
  CONTRACT {
    PRE: j < 16;
    POST: result >= 4278190080;
  }
  BODY {
    %0 = CAST.f32(j);
    %1 = FADD(%0, 0.5:f32);
    %2 = FDIV(%1, 16.0:f32);
    %3 = FSUB(1.0:f32, %2);
    %4 = FMUL(%2, %2);
    %5 = FMUL(%4, %2);
    %6 = FMUL(%3, %3);
    %7 = FMUL(%6, %3);
    %8 = FMUL(%3, %5);
    %9 = FMUL(%8, 2295.0:f32);
    %10 = FMUL(%6, %4);
    %11 = FMUL(%10, 3825.0:f32);
    %12 = FMUL(%7, %2);
    %13 = FMUL(%12, 2167.5:f32);
    %14 = CAST.u8(%9);
    %15 = CAST.u8(%11);
    %16 = CAST.u8(%13);
    %17 = CAST.u32(%14);
    %18 = CAST.u32(%15);
    %19 = CAST.u32(%16);
    %20 = SHL.checked(%18, 8:u32);
    %21 = SHL.checked(%19, 16:u32);
    %22 = OR(%17, %20);
    %23 = OR(%22, %21);
    %24 = OR(%23, 4278190080:u32);
    RETURN(%24);
  }
}

// Pixel i of the image: its point c in the complex plane, its escape time, and its colour. Points
// that never escape in 64 steps are black; the others take palette colour (count mod 16).
NODE @pixel [intent: "The colour of pixel i for a view centred on (cx, cy)"] {
  SIGNATURE: (i: u64, cx: f32, cy: f32, scale: f32, palette: Array<u32, 16>) -> (u32);
  EFFECTS: [];
  CONTRACT {
    PRE: i < 49152 && forall(j in 0..16) { palette[j] >= 4278190080 };
    POST: result >= 4278190080;
    INVARIANT @bounded(k, z): z.2 <= k;
  }
  BODY {
    %0 = MOD.checked(i, 256:u64);
    %1 = DIV.checked(i, 256:u64);
    %2 = CAST.f32(%0);
    %3 = CAST.f32(%1);
    %4 = FSUB(%2, 128.0:f32);
    %5 = FSUB(%3, 96.0:f32);
    %6 = FMUL(%4, scale);
    %7 = FADD(cx, %6);
    %8 = FMUL(%5, scale);
    %9 = FSUB(cy, %8);
    %10 = GENERATE(@tick, 64:u64);
    %11 = TUPLE(0.0:f32, 0.0:f32, 0:u32);
    %12 = FOLD_BOUNDED(@escape_step, %10, %7, %9, init=%11, invariant=@bounded);
    %13 = PROJ(%12, 2:u32);
    %14 = CAST.u64(%13);
    %15 = AND(%14, 15:u64);
    %16 = INDEX(palette, %15);
    %17 = EQ(%13, 64:u32);
    %18 = SELECT(%17, 4278190080:u32, %16);
    RETURN(%18);
  }
}

// The image. PRE keeps the view finite and on the set; the renderer then proves that every pixel
// is opaque, with no out-of-bounds read and no out-of-range conversion anywhere on the way.
NODE @render [intent: "Render a 256 x 192 view of the Mandelbrot set as RGBA pixels", export] {
  SIGNATURE: (cx: f32, cy: f32, scale: f32) -> (Array<u32, 49152>);
  EFFECTS: [];
  CONTRACT {
    PRE: cx >= -2.5 && cx <= 1.5 && cy >= -1.5 && cy <= 1.5 && scale > 0.0 && scale <= 0.02;
    POST: forall(i in 0..49152) { result[i] >= 4278190080 };
  }
  BODY {
    %0 = GENERATE(@palette_entry, 16:u64);
    %1 = GENERATE(@pixel, 49152:u64, cx, cy, scale, %0);
    RETURN(%1);
  }
}
